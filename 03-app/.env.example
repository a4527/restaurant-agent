# DiningConcierge 로컬 앱 환경변수
# 이 파일을 복사하여 .env로 저장하고 값을 채워주세요
# cp .env.example .env

# AgentCore Runtime ARN (필수)
# 확인: aws bedrock-agentcore-control list-agent-runtimes --region us-west-2
RUNTIME_ARN=

# AgentCore Memory ID (선택 - 없으면 Memory 기능 비활성화)
# 확인: aws bedrock-agentcore-control list-memories --region us-west-2
MEMORY_ID=

# Web Search Gateway URL (선택 - 없으면 웹 검색 비활성화)
# 확인: aws bedrock-agentcore-control list-gateways --region us-east-1
GATEWAY_WEB_SEARCH_URL=

# AWS 리전 (기본값: us-west-2)
AWS_REGION=us-west-2
